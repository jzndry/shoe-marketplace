# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=super_secret_jwt_key_solemarket_development_only_change_in_prod_32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (defaults to SQLite async for zero-dependency local dev; use Postgres for Docker)
DATABASE_URL=sqlite+aiosqlite:///./solemarket.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://solemarket:solemarket_secret@localhost:5432/solemarket_db

# Cache (leave empty for automatic in-memory fallback, or specify redis)
REDIS_URL=
# For Redis:
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Artificial Intelligence (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
